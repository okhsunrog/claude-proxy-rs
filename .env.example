# Admin credentials (required)
CLAUDE_PROXY_ADMIN_USERNAME=admin
CLAUDE_PROXY_ADMIN_PASSWORD=changeme
CLAUDE_PROXY_DATABASE_URL=postgresql://claude_proxy:changeme@127.0.0.1:5432/claude_proxy

# Proxy API key for testing
PROXY_API_KEY=sk-proxy-YOUR_API_KEY_HERE

# Persistent installation identity; default is .claude-proxy-device-id in the working directory.
# Keep this file across restarts. Send x-session-id (UUID) to distinguish conversations.
# CLAUDE_PROXY_DEVICE_ID_FILE=/opt/claude-proxy/.claude-proxy-device-id
